{
  "scanners": [
    {
      "id": "react",
      "source": "@groma/scanner-react@0.2.2",
      "include": [
        "**/*.ts",
        "**/*.tsx",
        "**/tsconfig*.json",
        "**/package.json",
        "**/*.html",
        "**/project.json",
        "**/nx.json"
      ],
      "exclude": [
        "*.test.ts",
        "*.test.tsx",
        "*.spec.ts",
        "*.spec.tsx",
        "/test/",
        "node_modules/",
        "dist/",
        "build/",
        "coverage/",
        "**/spec/",
        "/src/shared/testing/",
        "/playwright.config.ts",
        "/electron.vite.config.ts"
      ]
    },
    {
      "id": "typescript",
      "source": "@groma/scanner-typescript@0.2.3",
      "include": [
        "**/*.ts",
        "**/*.tsx",
        "**/tsconfig*.json",
        "**/package.json",
        "**/*.html",
        "**/angular.json",
        "**/project.json",
        "**/nx.json"
      ],
      "exclude": [
        "*.test.ts",
        "*.test.tsx",
        "*.spec.ts",
        "*.spec.tsx",
        "/test/",
        "node_modules/",
        "dist/",
        "build/",
        "coverage/",
        "**/spec/",
        "/src/shared/testing/",
        "/playwright.config.ts",
        "/electron.vite.config.ts"
      ]
    }
  ]
}
